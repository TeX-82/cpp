@ An operation like `\.{\\over}' causes the current mlist to go into a
state of suspended animation: |incompleat_noad| points to a |fraction_noad|
that contains the mlist-so-far as its numerator, while the denominator
is yet to come. Finally when the mlist is finished, the denominator will
go into the incompleat fraction noad, and that noad will become the
whole formula, unless it is surrounded by `\.{\\left}' and `\.{\\right}'
delimiters.

@p
static constexpr auto above_code=0; /* `\.{\\above}' */
static constexpr auto over_code=1; /* `\.{\\over}' */
static constexpr auto atop_code=2; /* `\.{\\atop}' */
static constexpr auto delimited_code=3; /* `\.{\\abovewithdelims}', etc.*/

Put_each_of_TeXs_primitives_into_the_hash_table = [&]() {
primitive(/*pool_string(*/"above"/*)pool_string*/, above, above_code);
primitive(/*pool_string(*/"over"/*)pool_string*/, above, over_code);
primitive(/*pool_string(*/"atop"/*)pool_string*/, above, atop_code);
primitive(/*pool_string(*/"abovewithdelims"/*)pool_string*/, above, delimited_code+above_code);
primitive(/*pool_string(*/"overwithdelims"/*)pool_string*/, above, delimited_code+over_code);
primitive(/*pool_string(*/"atopwithdelims"/*)pool_string*/, above, delimited_code+atop_code);
}};

Cases_of_print_cmd_chr_for_symbolic_printing_of_primitives = [&](quarterword cmd, halfword chr_code) { switch(cmd) {
case above: switch (chr_code) {
  case over_code: print_esc(/*pool_string(*/"over"/*)pool_string*/);break;
  case atop_code: print_esc(/*pool_string(*/"atop"/*)pool_string*/);break;
  case delimited_code+above_code: print_esc(/*pool_string(*/"abovewithdelims"/*)pool_string*/);break;
  case delimited_code+over_code: print_esc(/*pool_string(*/"overwithdelims"/*)pool_string*/);break;
  case delimited_code+atop_code: print_esc(/*pool_string(*/"atopwithdelims"/*)pool_string*/);break;
  default:print_esc(/*pool_string(*/"above"/*)pool_string*/);
  } break;
  default: return false; } return true; }};

Cases_of_main_control_that_build_boxes_and_lists = [&](integer mode_cur_cmd) { switch(mode_cur_cmd) {
case mmode+above: math_fraction();break;
default: return false; } return true; }};

void math_fraction()
{small_number c; /*the type of generalized fraction we are scanning*/
c=cur_chr;
if (incompleat_noad!=null)
  Ignore_the_fraction_operation_and_complain_about_this_ambiguous_case(c);
else{incompleat_noad=get_node(fraction_noad_size);
  type(incompleat_noad)=fraction_noad;
  subtype(incompleat_noad)=normal;
  math_type(numerator(incompleat_noad))=sub_mlist;
  info(numerator(incompleat_noad))=link(head);
  mem[denominator(incompleat_noad)].hh=empty_field;
  mem[left_delimiter(incompleat_noad)].qqqq=null_delimiter;
  mem[right_delimiter(incompleat_noad)].qqqq=null_delimiter;
  link(head)=null;tail=head;
  Use_code_to_distinguish_between_generalized_fractions(c);
  }
}

void Use_code_to_distinguish_between_generalized_fractions(small_number c) {
if (c >= delimited_code)
  {scan_delimiter(left_delimiter(incompleat_noad), false);
  scan_delimiter(right_delimiter(incompleat_noad), false);
  }
switch (c%delimited_code) {
case above_code: {scan_normal_dimen;
  thickness(incompleat_noad)=cur_val;
  } break;
case over_code: thickness(incompleat_noad)=default_code;break;
case atop_code: thickness(incompleat_noad)=0;
}  /*there are no other cases*/
}

void Ignore_the_fraction_operation_and_complain_about_this_ambiguous_case(small_number c) {
{if (c >= delimited_code)
  {scan_delimiter(garbage, false);scan_delimiter(garbage, false);
  }
if (c%delimited_code==above_code) scan_normal_dimen;
print_err("Ambiguous; you need another { and }");
/*Ambiguous...*/
help3("I'm ignoring this fraction specification, since I don't")
  ("know whether a construction like `x \\over y \\over z'")
  ("means `{x \\over y} \\over z' or `x \\over {y \\over z}'.");
error();
}
}

@ At the end of a math formula or subformula, the |fin_mlist| routine is
called upon to return a pointer to the newly completed mlist, and to
pop the nest back to the enclosing semantic level. The parameter to
|fin_mlist|, if not null, points to a |right_noad| that ends the
current mlist; this |right_noad| has not yet been appended.

@p pointer fin_mlist(pointer p)
{pointer q; /*the mlist to return*/
if (incompleat_noad!=null) Compleat_the_incompleat_noad(p, q);
else{link(tail)=p;q=link(head);
  }
pop_nest();return q;
}

void Compleat_the_incompleat_noad(pointer p, pointer& q) {
{math_type(denominator(incompleat_noad))=sub_mlist;
info(denominator(incompleat_noad))=link(head);
if (p==null) q=incompleat_noad;
else{q=info(numerator(incompleat_noad));
  if (type(q)!=left_noad) confusion(/*pool_string(*/"right"/*)pool_string*/);
@:this can't happen right}{\quad right@>
  info(numerator(incompleat_noad))=link(q);
  link(q)=incompleat_noad;link(incompleat_noad)=p;
  }
}
}

@ Now at last we're ready to see what happens when a right brace occurs
