default:confusion(/*pool_string(*/"rightbrace"/*)pool_string*/);
@:this can't happen rightbrace}{\quad rightbrace@>
}
}

void extra_right_brace()
{print_err("Extra }, or forgotten ");
/*Extra \}, or forgotten x*/
switch (cur_group) {
case semi_simple_group: print_esc(/*pool_string(*/"endgroup"/*)pool_string*/);break;
case math_shift_group: print_char('$');break;
