@ All glue parameters and registers are initially `\.{0pt plus0pt minus0pt}'.

@p Initialize_table_entries_done_by_INITEX_only = [&]() {
integer k; /*index into |mem|, |eqtb|, etc.*/
equiv(glue_base)=zero_glue;eq_level(glue_base)=level_one;
eq_type(glue_base)=glue_ref;
for_to(k, glue_base+1, local_base-1) eqtb[k]=eqtb[glue_base];
glue_ref_count(zero_glue)=glue_ref_count(zero_glue)+local_base-glue_base;
} };

void Show_equivalent_n_in_region_3(pointer n) {
if (n < skip_base)
  {print_skip_param(n-glue_base);print_char('=');
  if (n < glue_base+thin_mu_skip_code) print_spec(equiv(n),/*pool_string(*/"pt"/*)pool_string*/);
  else print_spec(equiv(n),/*pool_string(*/"mu"/*)pool_string*/);
  }
else if (n < mu_skip_base)
  {print_esc(/*pool_string(*/"skip"/*)pool_string*/);print_int(n-skip_base);print_char('=');
  print_spec(equiv(n),/*pool_string(*/"pt"/*)pool_string*/);
  }
else{print_esc(/*pool_string(*/"muskip"/*)pool_string*/);print_int(n-mu_skip_base);print_char('=');
  print_spec(equiv(n),/*pool_string(*/"mu"/*)pool_string*/);
  }
}

@ Region 4 of |eqtb| contains the local quantities defined here. The
bulk of this region is taken up by five tables that are indexed by eight-bit
characters; these tables are important to both the syntactic and semantic
portions of \TeX. There are also a bunch of special things like font and
token parameters, as well as the tables of \.{\\toks} and \.{\\box}
registers.

@p
#define par_shape_loc	local_base /*specifies paragraph shape*/
static constexpr auto output_routine_loc=(local_base+1); /*points to token list for \.{\\output}*/
static constexpr auto every_par_loc=(local_base+2); /*points to token list for \.{\\everypar}*/
static constexpr auto every_math_loc=(local_base+3); /*points to token list for \.{\\everymath}*/
static constexpr auto every_display_loc=(local_base+4); /*points to token list for \.{\\everydisplay}*/
static constexpr auto every_hbox_loc=(local_base+5); /*points to token list for \.{\\everyhbox}*/
static constexpr auto every_vbox_loc=(local_base+6); /*points to token list for \.{\\everyvbox}*/
static constexpr auto every_job_loc=(local_base+7); /*points to token list for \.{\\everyjob}*/
static constexpr auto every_cr_loc=(local_base+8); /*points to token list for \.{\\everycr}*/
static constexpr auto err_help_loc=(local_base+9); /*points to token list for \.{\\errhelp}*/
static constexpr auto toks_base=(local_base+10); /*table of 256 token list registers*/
static constexpr auto box_base=(toks_base+256); /*table of 256 box registers*/
static constexpr auto cur_font_loc=(box_base+256); /*internal font number outside math mode*/
