tex_ref_forward_v_(change_if_limit)
tex_ref_decltype_(if_limit); conditional_(tex& t) : tex_ref_(t) tex_ref_initialize_(if_limit) {

Push_the_condition_stack(p); save_cond_ptr=cond_ptr;this_if=cur_chr;
@<Either process \.{\\ifcase} or set |b| to the value of a boolean condition@>;
if (tracing_commands > 1) { Display_the_value_of(b); }
