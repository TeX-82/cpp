@ The user can force the equation number to go on a separate line
by causing its width to be zero.

@p void Squeeze_the_equation_as_much_as_possible_if_there_is_an_equation_number_that_should_go_on_a_separate_line_by_itself_set_e_0(
pointer p, pointer& b, scaled& w, scaled z, scaled& e, scaled q) {
{if ((e!=0)&&((w-total_shrink[normal]+q <= z)||@|
   (total_shrink[fil]!=0)||(total_shrink[fill]!=0)||
   (total_shrink[filll]!=0)))
