case outer_call: print_esc(/*pool_string(*/"outer macro"/*)pool_string*/);break;
case long_outer_call: {print_esc(/*pool_string(*/"long"/*)pool_string*/);print_esc(/*pool_string(*/"outer macro"/*)pool_string*/);
  } break;
case end_template: print_esc(/*pool_string(*/"outer endtemplate"/*)pool_string*/);break;
default: return false; } return true; }};

void Show_the_current_contents_of_a_box() {
{scan_eight_bit_int();begin_diagnostic();
print_nl("> \\box");print_int(cur_val);print_char('=');
if (box(cur_val)==null) print("void");
