primitive(/*pool_string(*/"outer"/*)pool_string*/, prefix, 2);
primitive(/*pool_string(*/"global"/*)pool_string*/, prefix, 4);
primitive(/*pool_string(*/"def"/*)pool_string*/, def, 0);
primitive(/*pool_string(*/"gdef"/*)pool_string*/, def, 1);
