  {change_if_limit(else_code, save_cond_ptr);
  return; /*wait for \.{\\else} or \.{\\fi}*/
  }
if (Skip_to_else_or_fi()) goto common_ending;
common_ending: if (cur_chr==fi_code) { Pop_the_condition_stack(p); }
else if_limit=fi_code; /*wait for \.{\\fi}*/
}

@ In a construction like `\.{\\if\\iftrue abc\\else d\\fi}', the first
\.{\\else} that we come to after learning that the \.{\\if} is false is
not the \.{\\else} we're looking for. Hence the following curious
logic is needed.

@p bool Skip_to_else_or_fi() {
loop{pass_text();
  if (cond_ptr==save_cond_ptr)
    {if (cur_chr!=or_code) return true; // goto common_ending;
    print_err("Extra ");print_esc(/*pool_string(*/"or"/*)pool_string*/);
/*Extra \\or*/
    help1("I'm ignoring this; it doesn't match any \\if.");
    error();
    }
  else if (cur_chr==fi_code) Pop_the_condition_stack(p);
  }
  return false;
}

