Cases_of_print_cmd_chr_for_symbolic_printing_of_primitives::map_t Cases_of_print_cmd_chr_for_symbolic_printing_of_primitives_functions;
inline boolean Cases_of_print_cmd_chr_for_symbolic_printing_of_primitives_(quarterword cmd, halfword chr_code)
